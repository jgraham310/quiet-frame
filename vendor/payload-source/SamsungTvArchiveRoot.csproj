<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(TV_TARGET_FRAMEWORK)' == ''">net6.0</TargetFramework><TargetFramework Condition="'$(TV_TARGET_FRAMEWORK)' != ''">$(TV_TARGET_FRAMEWORK)</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>SamsungTvArchiveRoot</AssemblyName>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SamsungTvArchiveRoot.cs" />
  </ItemGroup>
</Project>
